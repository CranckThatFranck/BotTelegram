# Configurações do TeleAgent Bridge
# Obtenha o token com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_1234567"

# Obtenha o seu ID com o @userinfobot no Telegram ou via getUpdates
TELEGRAM_CHAT_ID="987654321"

# Prefixo opcional para identificar a máquina/servidor nos alertas
TELEGRAM_BOT_HOSTNAME="Gaia-NV55C"

# Timeout padrão em segundos para perguntas interativas (ask)
TELEGRAM_ASK_TIMEOUT="300"

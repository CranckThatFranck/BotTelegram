{
  "teleagent-lifecycle": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "/home/francisco/Documentos/Projetos/BotTelegram/hooks/on_stop_hook.py"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/home/francisco/Documentos/Projetos/BotTelegram/hooks/on_error_hook.py"
          }
        ]
      }
    ]
  }
}
